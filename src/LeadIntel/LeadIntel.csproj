<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- the Dockerfile restores from the .csproj alone, before any .razor file exists; without this the SDK
         skips the package with _framework/blazor.web.js and the published dashboard loses interactivity -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.8.2" />
    <PackageReference Include="Anthropic" Version="12.51.0" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Data/schema.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
