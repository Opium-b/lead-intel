# SITE_ADDRESS: "https://1-2-3-4.sslip.io" (free HTTPS without a domain), a real domain, or ":80" for local tests.
{$SITE_ADDRESS}

encode gzip
header {
	Strict-Transport-Security "max-age=31536000"
	X-Content-Type-Options nosniff
	Referrer-Policy no-referrer
	-Server
}
handle /api/* {
	reverse_proxy api:8000
}
handle {
	root * /srv
	try_files {path} /index.html
	file_server
}
